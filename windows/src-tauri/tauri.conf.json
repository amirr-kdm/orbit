{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "2.1.3",
  "identifier": "com.amir.orbit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Orbit", "width": 1360, "height": 860, "minWidth": 1000, "minHeight": 680 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
